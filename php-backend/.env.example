# Copy this file to `.env` before deploying `php-backend/`

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dev_portfolio_cms
DB_USER=root
DB_PASS=your_strong_mysql_password

# Initial Admin Panel credentials (bcrypt-hashed automatically on first login)
ADMIN_EMAIL=admin@sura.dev
ADMIN_PASSWORD=change_me_before_production

# Public URL where this PHP backend is hosted (used for uploaded image URLs)
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:3000
APP_DEBUG=false
